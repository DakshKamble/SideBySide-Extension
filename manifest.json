{
  "manifest_version": 3,
  "name": "SideBySide",
  "description": "Simple watch party extension",
  "version": "0.1",

  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content.js"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "permissions": ["tabs", "storage", "alarms"],

  "host_permissions": [
    "ws://localhost:8888/"
  ]
}